<Window x:Class="Dateiumbenenner.PdfPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PDF Vorschau" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Modus:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbPdfPreviewMode" Width="180" SelectionChanged="CmbPdfPreviewMode_SelectionChanged" MaxDropDownHeight="180">
                <ComboBoxItem Content="Auto" IsSelected="True"/>
                <ComboBoxItem Content="WebView2"/>
                <ComboBoxItem Content="Text"/>
            </ComboBox>
            <TextBlock x:Name="TxtFileName" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold"/>
        </StackPanel>
        
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="PdfWebView" Visibility="Collapsed"/>
            <Image x:Name="ImgPdfPreview" Stretch="Uniform" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PdfTextScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtPdfFallback" 
                         IsReadOnly="True" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="Consolas"
                         FontSize="12"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

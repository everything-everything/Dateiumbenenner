<Window x:Class="Dateiumbenenner.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" Height="460" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="BtnOk_Click" Margin="0,0,6,0"/>
            <Button Content="Abbrechen" Width="80" IsCancel="True"/>
        </StackPanel>
        <CheckBox x:Name="ChkDebug" DockPanel.Dock="Top" Content="Debug-Dateien schreiben (Daten\debug)" Margin="0,0,0,10"/>
        <CheckBox x:Name="ChkAskTemplates" DockPanel.Dock="Top" Content="Vorlagen (Firma + Dokumenttyp) automatisch anbieten" Margin="0,0,0,10"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="Ausschlüsse Firmenerkennung (ein Begriff pro Zeile, z. B. Überschriften wie „Wartungstabellen“):"/>
        <TextBox x:Name="TxtExclusions" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
    </DockPanel>
</Window>

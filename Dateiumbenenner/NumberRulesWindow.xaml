<Window x:Class="Dateiumbenenner.NumberRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Belegarten &amp; Nummernmuster" Height="700" Width="1150"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="HintBox" TargetType="Border">
            <Setter Property="Background" Value="#FFF3F7FB"/>
            <Setter Property="BorderBrush" Value="#FFD3E0EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="DockPanel.Dock" Value="Top"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#FF3E4C5E"/>
        </Style>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="TestBox" TargetType="Border">
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="DockPanel.Dock" Value="Bottom"/>
        </Style>
        <!-- Spalten nur für Art „Merkmale“: bei „Maske“ ausgegraut und gesperrt (die Maske legt das bereits fest) -->
        <Style x:Key="FeatureCell" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Maske">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Background" Value="#FFF0F0F0"/>
                    <Setter Property="ToolTip" Value="Gilt nur f&#252;r Art &#8222;Merkmale&#8220; &#8211; bei &#8222;Maske&#8220; legt die Maske das fest."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Speichern &amp; Belegnummern neu ermitteln" Padding="10,3" Margin="0,0,8,0" Click="BtnSaveRecalc_Click"/>
            <Button Content="Speichern" Padding="10,3" Margin="0,0,8,0" IsDefault="True" Click="BtnSave_Click"/>
            <Button Content="Abbrechen" Padding="10,3" IsCancel="True"/>
        </StackPanel>
        <Border x:Name="PnlDocument" DockPanel.Dock="Top" BorderBrush="LightGray" BorderThickness="1" Padding="6" Margin="0,0,0,8" Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="Vorschau (PDF/TXT)" Padding="8,1" Click="BtnPreview_Click"
                            ToolTip="Ausgew&#228;hlten Beleg in der Programm-Vorschau anzeigen"/>
                    <TextBlock x:Name="TxtDocument" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <StackPanel x:Name="PnlSources" Margin="0,4,0,0"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" BorderBrush="LightGray" BorderThickness="1" Padding="6,4" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Firma:" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtTestCompany" Width="220" TextChanged="Test_Changed"/>
                <TextBlock Text="Belegart:" VerticalAlignment="Center" Margin="12,0,4,0" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtTestDocType" Width="150" TextChanged="Test_Changed"/>
                <TextBlock Text="gilt f&#252;r &#8222;Regel hinzuf&#252;gen&#8220;, Vorschl&#228;ge und Tests (leer = alle)" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
            </StackPanel>
        </Border>
        <DockPanel x:Name="PnlCompanies" DockPanel.Dock="Left" Width="210" Margin="0,0,8,0">
            <TextBlock DockPanel.Dock="Top" Text="Firmen" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtCompanyFilter" DockPanel.Dock="Top" Margin="0,0,0,4" ToolTip="Firmen filtern" TextChanged="TxtCompanyFilter_TextChanged"/>
            <ListBox x:Name="LstCompanies" SelectionChanged="LstCompanies_SelectionChanged"
                     ToolTip="Firma w&#228;hlen: Nummern-, Datums- und Betragsregeln dieser Firma (und * = alle) anzeigen"/>
        </DockPanel>
        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <TabItem x:Name="TabNumber" Header="Nummernmuster">
                <DockPanel Margin="5">
                    <Border Style="{StaticResource HintBox}">
                        <TextBlock Style="{StaticResource HintText}"
                               Text="Maske: $ = Ziffer, ? = Buchstabe, # = Ziffer oder Buchstabe, * = beliebiges Zeichen, Leerzeichen = Leerzeichen, sonst w&#246;rtlich (z. B. RE-$$$$$$ oder ???$$$$ $$$?). Begriff vor/nach Nummer: Text, der direkt vor bzw. hinter der Nummer steht &#8211; Nummern an dieser Stelle werden bevorzugt (beide eingetragen = Nummer steht dazwischen). Art &#8222;Merkmale&#8220; statt Maske: nur ungef&#228;hre L&#228;nge und erlaubte Zeichen (Spalten unten einblendbar). Firma/Belegart * = alle. H&#246;here Priorit&#228;t gewinnt; Abweichungen (l&#228;nger/k&#252;rzer) werden schw&#228;cher bewertet. Spalten-&#220;berschriften zeigen beim Darauf-Zeigen eine Erkl&#228;rung."/>
                    </Border>
                    <Border Style="{StaticResource TestBox}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Test &#8211; Nummer:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtTestValue" Width="180" TextChanged="Test_Changed"/>
                            <TextBlock x:Name="TxtTestResult" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Regel hinzuf&#252;gen" Style="{StaticResource BarButton}" Click="BtnAddRule_Click"/>
                        <Button Content="Vorschl&#228;ge f&#252;r Firma" Style="{StaticResource BarButton}" Click="BtnSuggest_Click" ToolTip="Je Belegart eine Regel f&#252;r die oben eingetragene Firma anlegen (Maske aus bisher erkannten Nummern)"/>
                        <Button Content="Markierte l&#246;schen" Style="{StaticResource BarButton}" Click="BtnDeleteRule_Click"/>
                        <Button Content="Gelernte Regeln l&#246;schen" Style="{StaticResource BarButton}" Click="BtnDeleteLearned_Click"/>
                        <CheckBox x:Name="ChkFeatureColumns" Content="Spalten f&#252;r Art &#8222;Merkmale&#8220; anzeigen" VerticalAlignment="Center" Margin="8,0,0,0"
                                  Checked="ChkFeatureColumns_Changed" Unchecked="ChkFeatureColumns_Changed"
                                  ToolTip="L&#228;nge, Ziffern, Buchstaben, Leerzeichen, Sonderzeichen &#8211; nur n&#246;tig, wenn eine Regel statt einer Maske ungef&#228;hre Merkmale verwendet"/>
                    </StackPanel>
                    <DataGrid x:Name="GridRules" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" CellEditEnding="GridRules_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Firma" Binding="{Binding Company, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                            <DataGridTextColumn Header="Belegart" Binding="{Binding DocType, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <DataGridTextColumn Header="Priorit&#228;t" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridComboBoxColumn x:Name="ColKind" Header="Art" SelectedItemBinding="{Binding Kind}" Width="80"/>
                            <DataGridTemplateColumn Header="Beispielnummer (w&#228;hlen/eingeben)" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" ItemsSource="{Binding Examples}" Text="{Binding Example, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                  SelectionChanged="Example_Changed" LostFocus="Example_LostFocus"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Maske" Binding="{Binding Mask, UpdateSourceTrigger=PropertyChanged}" Width="120" FontFamily="Consolas"/>
                            <DataGridTextColumn Binding="{Binding KeywordBefore}" Width="120">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Begriff (vor Nummer)" ToolTip="Begriff, der direkt vor der Nummer steht (gleiche Zeile oder Zeile dar&#252;ber), z. B. &#8222;Rechnung Nr.&#8220;. Nummern an dieser Stelle werden bevorzugt."/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding KeywordAfter}" Width="120">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Begriff (nach Nummer)" ToolTip="Begriff, der direkt hinter der Nummer steht. Sind beide Begriffe eingetragen, muss die Nummer zwischen ihnen stehen."/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Binding="{Binding KeywordEitherSide, UpdateSourceTrigger=PropertyChanged}" Width="70">
                                <DataGridCheckBoxColumn.Header>
                                    <TextBlock Text="Seite egal" ToolTip="Nur ein Begriff eingetragen: er darf vor ODER hinter der Nummer stehen."/>
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn x:Name="ColMinLen" Binding="{Binding MinLength, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="65" CellStyle="{StaticResource FeatureCell}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="L&#228;nge min" ToolTip="Nur Art &#8222;Merkmale&#8220;: Mindestl&#228;nge der Nummer (k&#252;rzere werden schw&#228;cher bewertet). Bei &#8222;Maske&#8220; ergibt sich die L&#228;nge aus der Maske."/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="ColMaxLen" Binding="{Binding MaxLength, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="65" CellStyle="{StaticResource FeatureCell}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="L&#228;nge max" ToolTip="Nur Art &#8222;Merkmale&#8220;: H&#246;chstl&#228;nge der Nummer (l&#228;ngere werden schw&#228;cher bewertet)."/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn x:Name="ColDigits" Binding="{Binding AllowDigits, UpdateSourceTrigger=PropertyChanged}" Width="55" CellStyle="{StaticResource FeatureCell}">
                                <DataGridCheckBoxColumn.Header>
                                    <TextBlock Text="Ziffern" ToolTip="Nur Art &#8222;Merkmale&#8220;: Nummer darf Ziffern 0&#8211;9 enthalten (bei &#8222;Maske&#8220; steht daf&#252;r $)."/>
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridCheckBoxColumn x:Name="ColLetters" Binding="{Binding AllowLetters, UpdateSourceTrigger=PropertyChanged}" Width="75" CellStyle="{StaticResource FeatureCell}">
                                <DataGridCheckBoxColumn.Header>
                                    <TextBlock Text="Buchstaben" ToolTip="Nur Art &#8222;Merkmale&#8220;: Nummer darf Buchstaben enthalten (bei &#8222;Maske&#8220; steht daf&#252;r ?)."/>
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridCheckBoxColumn x:Name="ColSpace" Binding="{Binding AllowSpace, UpdateSourceTrigger=PropertyChanged}" Width="80" CellStyle="{StaticResource FeatureCell}">
                                <DataGridCheckBoxColumn.Header>
                                    <TextBlock Text="Leerzeichen" ToolTip="Nur Art &#8222;Merkmale&#8220;: Nummer darf Leerzeichen enthalten (z. B. &#8222;123 456&#8220;)."/>
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridCheckBoxColumn x:Name="ColSymbols" Binding="{Binding AllowSymbols, UpdateSourceTrigger=PropertyChanged}" Width="90" CellStyle="{StaticResource FeatureCell}">
                                <DataGridCheckBoxColumn.Header>
                                    <TextBlock Text="Sonderzeichen" ToolTip="Nur Art &#8222;Merkmale&#8220;: Nummer darf Zeichen wie - / . enthalten (z. B. &#8222;RE-2024/17&#8220;)."/>
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Binding="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Width="80">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Beginnt mit" ToolTip="Pr&#228;fix (optional): Nummern, die nicht so anfangen, werden schw&#228;cher bewertet (z. B. &#8222;RE&#8220; f&#252;r RE-12345). Bei einer Maske meist &#252;berfl&#252;ssig, weil feste Zeichen schon in der Maske stehen."/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Binding="{Binding Learned}" Width="60" IsReadOnly="True">
                                <DataGridCheckBoxColumn.Header>
                                    <TextBlock Text="Gelernt" ToolTip="Automatisch angelegt, als eine Nummer von Hand ausgew&#228;hlt wurde (niedrige Priorit&#228;t). Mit &#8222;Gelernte Regeln l&#246;schen&#8220; entfernbar; eigene Regeln haben Vorrang."/>
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="TabDate" Header="Datum">
                <DockPanel Margin="5">
                    <Border Style="{StaticResource HintBox}">
                        <TextBlock Style="{StaticResource HintText}"
                               Text="Belegdatum je Firma/Belegart (* = alle): Begriff, bei dem das Datum steht (z. B. Rechnungsdatum, Lieferdatum, Belegdatum), Lage rechts daneben, links davor oder darunter (Spalte), und die Schreibweise im Beleg. Die Schreibweise (Datumsformat) gilt auch f&#252;r die XML-Erzeugung und den XML-Editor: TT.MM.JJJJ = (Datum), Monatsname = (DatumJan), JJJJ-MM-TT = (DatumJMT), MM/TT/JJJJ = (DatumUS), eigene Maske = (DatumFrei(&#8230;)). Ohne Begriff wird nur die Schreibweise festgelegt. Ohne Treffer bleibt die bisherige Erkennung."/>
                    </Border>
                    <Border Style="{StaticResource TestBox}">
                        <DockPanel>
                            <TextBlock Text="Test &#8211; Textzeile:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtDateTest" Width="280" TextChanged="Test_Changed"
                                     ToolTip="z. B. &#8222;Lieferdatum: 3. M&#228;rz 2024&#8220;; leer = Text des oben angezeigten Belegs"/>
                            <TextBlock x:Name="TxtDateTestResult" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Regel hinzuf&#252;gen" Style="{StaticResource BarButton}" Click="BtnAddDateRule_Click"/>
                        <Button Content="Aus aktuellem Beleg &#252;bernehmen" Style="{StaticResource BarButton}" Click="BtnDateFromDocument_Click"
                                ToolTip="Begriff, Lage und Schreibweise des Datums aus dem oben angezeigten Beleg als Regel f&#252;r Firma/Belegart anlegen"/>
                        <Button Content="Markierte l&#246;schen" Style="{StaticResource BarButton}" Click="BtnDeleteDateRule_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="GridDateRules" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" CellEditEnding="GridRules_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Firma" Binding="{Binding Company, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridTextColumn Header="Belegart" Binding="{Binding DocType, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="Begriff" Binding="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                            <DataGridComboBoxColumn x:Name="ColDatePos" Header="Lage Begriff" SelectedItemBinding="{Binding Position}" Width="100"/>
                            <DataGridComboBoxColumn x:Name="ColDateFormat" Header="Schreibweise (Datumsformat)" SelectedValueBinding="{Binding Format}"
                                                    SelectedValuePath="Value" DisplayMemberPath="Label" Width="210"/>
                            <DataGridTextColumn Header="Eigene Maske" Binding="{Binding Mask, UpdateSourceTrigger=PropertyChanged}" Width="110" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Priorit&#228;t" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="TabAmount" Header="Betrag">
                <DockPanel Margin="5">
                    <Border Style="{StaticResource HintBox}">
                        <TextBlock Style="{StaticResource HintText}"
                               Text="Bevorzugter Begriff f&#252;r den Betrag je Firma/Belegart (* = alle), z. B. Warenwert, Gesamtbetrag, Zahlbetrag. Lage: rechts daneben oder darunter (Spalte). Seite: erste oder letzte Seite. Ohne Treffer wird wie bisher der h&#246;chste Betrag genommen. Bei mehreren Belegen in einer Datei z&#228;hlen nur die Seiten der gew&#228;hlten Firma."/>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Regel hinzuf&#252;gen" Style="{StaticResource BarButton}" Click="BtnAddAmountRule_Click"/>
                        <Button Content="Markierte l&#246;schen" Style="{StaticResource BarButton}" Click="BtnDeleteAmountRule_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="GridAmountRules" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Firma" Binding="{Binding Company, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridTextColumn Header="Belegart" Binding="{Binding DocType, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="Begriff" Binding="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                            <DataGridComboBoxColumn x:Name="ColAmountPos" Header="Lage Begriff" SelectedItemBinding="{Binding Position}" Width="100"/>
                            <DataGridTextColumn Header="Begriff Ende" Binding="{Binding KeywordEnd, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <DataGridComboBoxColumn x:Name="ColAmountPage" Header="Seite" SelectedItemBinding="{Binding Page}" Width="100"/>
                            <DataGridTextColumn Header="Priorit&#228;t" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="TabDocTypes" Header="Belegarten">
                <DockPanel Margin="5">
                    <Border Style="{StaticResource HintBox}">
                        <TextBlock Style="{StaticResource HintText}"
                               Text="Eigene Belegarten festlegen (gilt f&#252;r alle Firmen). Umschreibungen werden bei der Erkennung der Belegart zugeordnet (z. B. Sendeinformation &#8594; Lieferschein). Nummer-Schl&#252;sselw&#246;rter: Begriffe, hinter denen die Belegnummer steht. Mehrere Eintr&#228;ge mit ; trennen."/>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Belegart hinzuf&#252;gen" Style="{StaticResource BarButton}" Click="BtnAddDocType_Click"/>
                        <Button Content="Markierte l&#246;schen" Style="{StaticResource BarButton}" Click="BtnDeleteDocType_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="GridDocTypes" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Belegart" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                            <DataGridTextColumn Header="Umschreibungen (;-getrennt)" Binding="{Binding Synonyms, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Nummer-Schl&#252;sselw&#246;rter (;-getrennt)" Binding="{Binding Keywords, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

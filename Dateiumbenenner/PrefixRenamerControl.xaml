<UserControl x:Class="Dateiumbenenner.PrefixRenamerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Präfix-Umbenennung" FontSize="16" FontWeight="Bold" Margin="10"/>

        <!-- Einstellungen -->
        <GroupBox Grid.Row="1" Header="Einstellungen" Margin="10,0,10,10">
            <StackPanel>
                <!-- Anleitung -->
                <Border Background="LightYellow" BorderBrush="Orange" BorderThickness="1" Padding="8" Margin="0,0,0,10">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="📌 Anleitung:" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="1. Klicken Sie auf 'Vom Hauptfenster laden' um Dateien zu importieren"/>
                        <LineBreak/>
                        <Run Text="2. Firmennamen werden automatisch erkannt und in der Spalte 'Erkannter Firmenname' angezeigt"/>
                        <LineBreak/>
                        <Run Text="3. Wählen Sie einen Firmennamen aus der Dropdown-Liste oder geben Sie einen eigenen ein"/>
                        <LineBreak/>
                        <Run Text="4. Mit 'Firmenname auf alle/markierte übertragen' können Sie den Firmennamen kopieren"/>
                        <LineBreak/>
                        <Run Text="5. Klicken Sie 'Firmenname verwenden' um den Firmennamen als Präfix zu setzen"/>
                        <LineBreak/>
                        <Run Text="6. Mit 'Präfix auf alle/markierte anwenden' können Sie den Präfix auf andere Dateien übertragen"/>
                        <LineBreak/>
                        <Run Text="7. Klicken Sie 'Dateien umbenennen' um die Änderungen zu speichern"/>
                        <LineBreak/>
                        <LineBreak/>
                        <Run Text="💡 Tipp: Nutzen Sie die Checkbox-Spalte um gezielt Dateien auszuwählen!" FontStyle="Italic" Foreground="DarkBlue"/>
                    </TextBlock>
                </Border>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Trennzeichen:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Column="1" x:Name="TxtDelimiterPrefix" Text="_" Margin="5" TextChanged="TxtDelimiterPrefix_TextChanged"/>

                    <TextBlock Grid.Column="2" Text="Segment-Index:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Column="3" x:Name="TxtSegmentIndexPrefix" Text="2" Margin="5" TextChanged="TxtSegmentIndexPrefix_TextChanged"/>

                    <TextBlock Grid.Column="4" Text="Segmente entfernen:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Column="5" x:Name="TxtRemoveSegments" Text="0" Margin="5" TextChanged="TxtRemoveSegments_TextChanged"/>

                    <Button Grid.Column="6" Content="Vom Hauptfenster laden" Click="BtnLoadFromMain_Click" Margin="5" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Dateiliste -->
        <GroupBox Grid.Row="2" Header="Dateien und Vorschau" Margin="10,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Linke Seite: Dateiliste -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Buttons -->
                    <WrapPanel Grid.Row="0" Margin="5">
                        <Button Content="Alle auswählen" Click="BtnSelectAll_Click" Margin="0,0,5,0" Padding="10,3"/>
                        <Button Content="Alle abwählen" Click="BtnDeselectAll_Click" Margin="0,0,5,0" Padding="10,3"/>
                        
                        <Separator Margin="5,0,5,0" Width="2" Background="LightGray"/>
                        
                        <Button Content="Firmenname verwenden" Click="BtnUseCompanyName_Click" Margin="0,0,5,0" Padding="10,3" FontWeight="Bold" Background="LightBlue">
                            <Button.ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="350">
                                    <Run Text="Übernimmt den ausgewählten Firmennamen als neuen Präfix für die aktuelle Datei." FontWeight="Bold"/>
                                    <LineBreak/>
                                    <Run Text="Der Firmenname wird automatisch aus dem PDF extrahiert."/>
                                    <LineBreak/>
                                    <Run Text="Sie können auch einen eigenen Namen in die ComboBox eingeben."/>
                                </TextBlock>
                            </Button.ToolTip>
                        </Button>
                        <Button Content="Firmenname auf markierte übertragen" Click="BtnApplyCompanyNameToSelected_Click" Margin="0,0,5,0" Padding="10,3" Background="LightCyan">
                            <Button.ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="350">
                                    <Run Text="Überträgt den gewählten Firmennamen auf alle markierten Dateien (Checkbox)." FontWeight="Bold"/>
                                    <LineBreak/>
                                    <Run Text="Die Firmennamen-Auswahl wird kopiert, auch wenn der Name nicht in der Liste ist."/>
                                </TextBlock>
                            </Button.ToolTip>
                        </Button>
                        <Button Content="Firmenname auf alle übertragen" Click="BtnApplyCompanyNameToAll_Click" Margin="0,0,5,0" Padding="10,3" Background="LightCyan">
                            <Button.ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="350">
                                    <Run Text="Überträgt den gewählten Firmennamen auf ALLE Dateien in der Liste." FontWeight="Bold"/>
                                    <LineBreak/>
                                    <Run Text="Der Name wird auch gesetzt, wenn er nicht in der Kandidatenliste ist."/>
                                </TextBlock>
                            </Button.ToolTip>
                        </Button>
                        
                        <Separator Margin="5,0,5,0" Width="2" Background="LightGray"/>
                        
                        <Button Content="Präfix auf markierte anwenden" Click="BtnApplyToSelected_Click" Margin="0,0,5,0" Padding="10,3">
                            <Button.ToolTip>
                                <TextBlock Text="Überträgt den Präfix der ausgewählten Zeile auf alle markierten Dateien (Checkbox)."/>
                            </Button.ToolTip>
                        </Button>
                        <Button Content="Präfix auf alle anwenden" Click="BtnApplyToAll_Click" Margin="0,0,5,0" Padding="10,3">
                            <Button.ToolTip>
                                <TextBlock Text="Überträgt den Präfix der ausgewählten Zeile auf ALLE Dateien in der Liste."/>
                            </Button.ToolTip>
                        </Button>
                        
                        <Separator Margin="5,0,5,0" Width="2" Background="LightGray"/>
                        
                        <Button Content="Segmente von markierten entfernen" Click="BtnRemoveSegmentsFromSelected_Click" Margin="0,0,5,0" Padding="10,3">
                            <Button.ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="350">
                                    <Run Text="Entfernt N Segmente vom Suffix der markierten Dateien." FontWeight="Bold"/>
                                    <LineBreak/>
                                    <Run Text="Beispiel: Bei '2' werden die ersten 2 Segmente nach dem Trennzeichen entfernt."/>
                                </TextBlock>
                            </Button.ToolTip>
                        </Button>
                    </WrapPanel>

                    <!-- ListView -->
                    <ListView Grid.Row="1" x:Name="LvPrefixFiles" Margin="5" SelectionChanged="LvPrefixFiles_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="✓" Width="30">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Dateiname" Width="200" DisplayMemberBinding="{Binding FileName}"/>
                                <GridViewColumn Header="Aktueller Präfix" Width="150" DisplayMemberBinding="{Binding CurrentPrefix}"/>
                                <GridViewColumn Header="Suffix (nach Segment)" Width="200" DisplayMemberBinding="{Binding CurrentSuffix}"/>
                                <GridViewColumn Header="Erkannter Firmenname (editierbar)" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding CompanyNameCandidates}" 
                                                      SelectedItem="{Binding SelectedCompanyName, UpdateSourceTrigger=PropertyChanged}"
                                                      Text="{Binding SelectedCompanyName, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True"
                                                      BorderThickness="0" 
                                                      Background="Transparent"
                                                      MaxDropDownHeight="200">
                                                <ComboBox.ToolTip>
                                                    <TextBlock>
                                                        <Run Text="Wählen Sie einen erkannten Firmennamen oder geben Sie einen eigenen ein."/>
                                                        <LineBreak/>
                                                        <Run Text="Klicken Sie auf 'Firmenname verwenden' um ihn als Präfix zu übernehmen." FontStyle="Italic"/>
                                                    </TextBlock>
                                                </ComboBox.ToolTip>
                                            </ComboBox>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Neuer Präfix" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding NewPrefix, UpdateSourceTrigger=PropertyChanged}" 
                                                     BorderThickness="0" Background="Transparent" TextChanged="TxtNewPrefix_TextChanged"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Neuer Dateiname" Width="250" DisplayMemberBinding="{Binding NewFileName}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!-- GridSplitter -->
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="LightGray" ShowsPreview="True"/>

                <!-- Rechte Seite: Vorschau -->
                <GroupBox Grid.Column="2" Header="Dateivorschau" Padding="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Dateiname:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TxtPreviewFileName" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Aktueller Präfix:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TxtPreviewCurrentPrefix" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Suffix:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TxtPreviewSuffix" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Erkannter Firmenname:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbPreviewCompanyName" 
                                      IsEditable="True" 
                                      Margin="0,0,0,10"
                                      SelectionChanged="CmbPreviewCompanyName_SelectionChanged"
                                      LostFocus="CmbPreviewCompanyName_LostFocus">
                                <ComboBox.ToolTip>
                                    <TextBlock Text="Wählen Sie einen Namen aus oder geben Sie einen eigenen ein."/>
                                </ComboBox.ToolTip>
                            </ComboBox>
                            
                            <TextBlock Text="Neuer Präfix (editierbar):" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtPreviewNewPrefix" 
                                     TextWrapping="Wrap" 
                                     Margin="0,0,0,10"
                                     TextChanged="TxtPreviewNewPrefix_TextChanged"/>
                            
                            <Separator Margin="0,10"/>
                            
                            <TextBlock Text="Vorschau neuer Dateiname:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TxtPreviewNewFileName" 
                                       TextWrapping="Wrap" 
                                       FontWeight="Bold" 
                                       Foreground="Green"
                                       Margin="0,0,0,10"/>
                            

                            <TextBlock Text="Textvorschau (erste Zeilen):" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Border BorderBrush="LightGray" BorderThickness="1" Padding="5" Background="WhiteSmoke">
                                <TextBlock x:Name="TxtPreviewContent" 
                                           TextWrapping="Wrap" 
                                           FontFamily="Consolas" 
                                           FontSize="10"
                                           MaxHeight="200"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </GroupBox>

        <!-- Aktionen -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Dateien umbenennen" Click="BtnRenameFiles_Click" Padding="20,5" FontWeight="Bold" Background="LightGreen"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="4" x:Name="TxtPrefixStatus" Text="Bereit." Margin="10,0,10,10" FontStyle="Italic"/>
    </Grid>
</UserControl>

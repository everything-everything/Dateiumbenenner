<Window x:Class="Dateiumbenenner.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hilfe" Height="650" Width="800" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <Button DockPanel.Dock="Bottom" Content="Schließen" Width="100" HorizontalAlignment="Right" Margin="0,10,0,0" IsCancel="True" Click="BtnClose_Click"/>
        <TabControl x:Name="Tabs">
            <TabItem Header="Programmhilfe">
                <TextBox x:Name="TxtHelp" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" BorderThickness="0"/>
            </TabItem>
            <TabItem Header="Lizenzen">
                <TextBox x:Name="TxtLicenses" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" BorderThickness="0"/>
            </TabItem>
            <TabItem Header="Über / Impressum">
                <StackPanel Margin="5">
                    <TextBox x:Name="TxtAbout" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" BorderThickness="0"/>
                    <TextBlock Margin="0,10,0,0">
                        <Hyperlink NavigateUri="https://github.com/everything-everything" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/everything-everything</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

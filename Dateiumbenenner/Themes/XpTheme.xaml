<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows-XP-Stil (Luna), passend zum Hilfefenster. Gilt programmweit als Standardstil. -->
    <SolidColorBrush x:Key="XpFace" Color="#ECE9D8"/>
    <SolidColorBrush x:Key="XpBorder" Color="#7F9DB9"/>
    <SolidColorBrush x:Key="XpButtonBorder" Color="#003C74"/>
    <SolidColorBrush x:Key="XpHot" Color="#E69B00"/>

    <LinearGradientBrush x:Key="XpButtonFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F4F3EE" Offset="0.6"/>
        <GradientStop Color="#D6D0C5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="XpBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAF9F5" Offset="0"/>
        <GradientStop Color="#E5E2D5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="XpHeader" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#EBEADB" Offset="0.8"/>
        <GradientStop Color="#D6D3C6" Offset="1"/>
    </LinearGradientBrush>

    <!-- Schaltflächen -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Background" Value="{StaticResource XpButtonFace}"/>
        <Setter Property="BorderBrush" Value="{StaticResource XpButtonBorder}"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="MinHeight" Value="23"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outer" CornerRadius="3" BorderThickness="1" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource XpHot}"/>
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="Outer" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outer" Property="Background" Value="#E3E2DA"/>
                            <Setter TargetName="Cp" Property="Margin" Value="1,1,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Outer" Property="BorderBrush" Value="#C9C7BA"/>
                            <Setter TargetName="Outer" Property="Background" Value="#F5F4EA"/>
                            <Setter Property="Foreground" Value="#ACA899"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menü und Leisten -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource XpFace}"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
    </Style>
    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="{StaticResource XpBar}"/>
    </Style>
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource XpFace}"/>
        <Setter Property="BorderBrush" Value="#ACA899"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <!-- Registerkarten (XP: orange Oberkante bei Auswahl/Hover) -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="#FCFCFE"/>
        <Setter Property="BorderBrush" Value="#919B9C"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root" Margin="0,2,0,0">
                        <Border x:Name="Bd" Background="{StaticResource XpHeader}" BorderBrush="#919B9C"
                                BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Padding="10,3" Margin="0,0,1,0">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Hot" Height="3" VerticalAlignment="Top" CornerRadius="3,3,0,0" Margin="0,0,1,0"
                                Background="#FFC83C" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Hot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Hot" Property="Background" Value="#E68B2C"/>
                            <Setter TargetName="Bd" Property="Background" Value="#FCFCFE"/>
                            <Setter TargetName="Root" Property="Margin" Value="-2,0,-2,-1"/>
                            <Setter Property="Panel.ZIndex" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#ACA899"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eingabefelder und Listen mit blauem XP-Rahmen -->
    <Style TargetType="TextBox">
        <Setter Property="BorderBrush" Value="{StaticResource XpBorder}"/>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="BorderBrush" Value="{StaticResource XpBorder}"/>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="BorderBrush" Value="{StaticResource XpBorder}"/>
    </Style>
    <Style TargetType="ListView">
        <Setter Property="BorderBrush" Value="{StaticResource XpBorder}"/>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="BorderBrush" Value="{StaticResource XpBorder}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E5E2D5"/>
        <Setter Property="VerticalGridLinesBrush" Value="#E5E2D5"/>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="#D0D0BF"/>
        <Setter Property="Foreground" Value="#0046D5"/>
    </Style>

    <!-- Spaltenköpfe wie im XP-Explorer -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource XpHeader}"/>
        <Setter Property="BorderBrush" Value="#D6D3C6"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Padding" Value="5,3"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource XpHeader}"/>
        <Setter Property="BorderBrush" Value="#D6D3C6"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="5,3"/>
    </Style>

    <!-- Bildlaufleisten im Luna-Stil (blaue Pfeiltasten und Schieber, helle Leiste) -->
    <LinearGradientBrush x:Key="XpScrollTrackV" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#EEEDE5" Offset="0"/>
        <GradientStop Color="#FBFBF8" Offset="0.35"/>
        <GradientStop Color="#F5F4EF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="XpScrollTrackH" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EEEDE5" Offset="0"/>
        <GradientStop Color="#FBFBF8" Offset="0.35"/>
        <GradientStop Color="#F5F4EF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="XpScrollFaceV" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E3EBFE" Offset="0"/>
        <GradientStop Color="#CAD9FC" Offset="0.5"/>
        <GradientStop Color="#B4C8F6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="XpScrollFaceH" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E3EBFE" Offset="0"/>
        <GradientStop Color="#CAD9FC" Offset="0.5"/>
        <GradientStop Color="#B4C8F6" Offset="1"/>
    </LinearGradientBrush>
    <Geometry x:Key="XpArrowUp">M 0,4 L 3.5,0.5 L 7,4</Geometry>
    <Geometry x:Key="XpArrowDown">M 0,0.5 L 3.5,4 L 7,0.5</Geometry>
    <Geometry x:Key="XpArrowLeft">M 4,0 L 0.5,3.5 L 4,7</Geometry>
    <Geometry x:Key="XpArrowRight">M 0.5,0 L 4,3.5 L 0.5,7</Geometry>

    <Style x:Key="XpScrollArrow" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Outer" CornerRadius="3" BorderThickness="1" BorderBrush="#B1C4F2" Margin="0,0,0,0" SnapsToDevicePixels="True">
                        <Grid>
                            <Border CornerRadius="2" BorderThickness="1" BorderBrush="#F7FAFF" Background="{TemplateBinding Background}"/>
                            <Border x:Name="Overlay" CornerRadius="2" Background="Transparent"/>
                            <Path x:Name="Glyph" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="#4D6185" StrokeThickness="2"
                                  StrokeStartLineCap="Square" StrokeEndLineCap="Square" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="#55FFFFFF"/>
                            <Setter TargetName="Outer" Property="BorderBrush" Value="#98B1EC"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="#506E8EEB"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="XpScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="XpScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Outer" CornerRadius="3" BorderThickness="1" BorderBrush="#B1C4F2" SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <Border CornerRadius="2" BorderThickness="1" BorderBrush="#F7FAFF" Background="{TemplateBinding Background}"/>
                            <Border x:Name="Overlay" CornerRadius="2" Background="Transparent"/>
                            <ContentPresenter Content="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="#55FFFFFF"/>
                            <Setter TargetName="Outer" Property="BorderBrush" Value="#98B1EC"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="#506E8EEB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="XpVScrollBar" TargetType="ScrollBar">
        <Grid Background="{StaticResource XpScrollTrackV}" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="17"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>
            <RepeatButton Grid.Row="0" Style="{StaticResource XpScrollArrow}" Background="{StaticResource XpScrollFaceV}" Tag="{StaticResource XpArrowUp}" Command="ScrollBar.LineUpCommand"/>
            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource XpScrollPage}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource XpScrollThumb}" Background="{StaticResource XpScrollFaceV}">
                        <Thumb.Tag>
                            <StackPanel>
                                <Rectangle Width="7" Height="1" Fill="#EEF4FE"/><Rectangle Width="7" Height="1" Fill="#8CB0F8"/>
                                <Rectangle Width="7" Height="1" Fill="#EEF4FE"/><Rectangle Width="7" Height="1" Fill="#8CB0F8"/>
                                <Rectangle Width="7" Height="1" Fill="#EEF4FE"/><Rectangle Width="7" Height="1" Fill="#8CB0F8"/>
                                <Rectangle Width="7" Height="1" Fill="#EEF4FE"/><Rectangle Width="7" Height="1" Fill="#8CB0F8"/>
                            </StackPanel>
                        </Thumb.Tag>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource XpScrollPage}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="2" Style="{StaticResource XpScrollArrow}" Background="{StaticResource XpScrollFaceV}" Tag="{StaticResource XpArrowDown}" Command="ScrollBar.LineDownCommand"/>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="XpHScrollBar" TargetType="ScrollBar">
        <Grid Background="{StaticResource XpScrollTrackH}" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="17"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="17"/>
            </Grid.ColumnDefinitions>
            <RepeatButton Grid.Column="0" Style="{StaticResource XpScrollArrow}" Background="{StaticResource XpScrollFaceH}" Tag="{StaticResource XpArrowLeft}" Command="ScrollBar.LineLeftCommand"/>
            <Track x:Name="PART_Track" Grid.Column="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource XpScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource XpScrollThumb}" Background="{StaticResource XpScrollFaceH}">
                        <Thumb.Tag>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="1" Height="7" Fill="#EEF4FE"/><Rectangle Width="1" Height="7" Fill="#8CB0F8"/>
                                <Rectangle Width="1" Height="7" Fill="#EEF4FE"/><Rectangle Width="1" Height="7" Fill="#8CB0F8"/>
                                <Rectangle Width="1" Height="7" Fill="#EEF4FE"/><Rectangle Width="1" Height="7" Fill="#8CB0F8"/>
                                <Rectangle Width="1" Height="7" Fill="#EEF4FE"/><Rectangle Width="1" Height="7" Fill="#8CB0F8"/>
                            </StackPanel>
                        </Thumb.Tag>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource XpScrollPage}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Column="2" Style="{StaticResource XpScrollArrow}" Background="{StaticResource XpScrollFaceH}" Tag="{StaticResource XpArrowRight}" Command="ScrollBar.LineRightCommand"/>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Width" Value="17"/>
        <Setter Property="MinWidth" Value="17"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template" Value="{StaticResource XpVScrollBar}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="17"/>
                <Setter Property="MinHeight" Value="17"/>
                <Setter Property="Template" Value="{StaticResource XpHScrollBar}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

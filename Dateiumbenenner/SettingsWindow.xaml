<Window x:Class="Dateiumbenenner.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" Height="660" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="BtnOk_Click" Margin="0,0,6,0"/>
            <Button Content="Abbrechen" Width="80" IsCancel="True"/>
        </StackPanel>
        <CheckBox x:Name="ChkDebug" DockPanel.Dock="Top" Content="Debug-Dateien schreiben (Daten\debug)" Margin="0,0,0,10"/>
        <CheckBox x:Name="ChkAskTemplates" DockPanel.Dock="Top" Content="Vorlagen (Firma + Dokumenttyp) automatisch anbieten" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"
                    ToolTip="Ab dieser Ähnlichkeit gelten zwei Firmennamen als gleich (OCR-Fehler) – auch beim Umstellen weiterer Belege. Standard 82 %.">
            <TextBlock Text="Übereinstimmung Firmennamen (50–100 %):" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtThreshold" Width="50" MaxLength="3" HorizontalContentAlignment="Right"/>
            <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"
                    ToolTip="Weitere Belege werden nur mit umgestellt, wenn so viele Einträge ihrer Firmen-Auswahlliste gleich/ähnlich in der Liste des bearbeiteten Belegs stehen. Standard 50 %.">
            <TextBlock Text="Übereinstimmung Auswahllisten (0–100 %):" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtListThreshold" Width="50" MaxLength="3" HorizontalContentAlignment="Right"/>
            <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </StackPanel>
        <GroupBox DockPanel.Dock="Top" Header="Eigene Firma (Belege ohne fremde Adresse = eigene/interne Belege)" Margin="0,0,0,10">
            <Grid Margin="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <TextBox x:Name="TxtOwnName" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Text="Straße:" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <TextBox x:Name="TxtOwnStreet" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="2" Text="PLZ:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtOwnZip" Grid.Row="2" Grid.Column="1" MaxLength="5"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Ort:" VerticalAlignment="Center" Margin="8,0,6,0"/>
                <TextBox x:Name="TxtOwnCity" Grid.Row="2" Grid.Column="3"/>
            </Grid>
        </GroupBox>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="Ausschlüsse Firmenerkennung (ein Begriff pro Zeile, z. B. Überschriften wie Wartungstabellen):"/>
        <TextBox x:Name="TxtExclusions" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
    </DockPanel>
</Window>

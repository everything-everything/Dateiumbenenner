<Window x:Class="Dateiumbenenner.PdfPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PDF Vorschau" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <WrapPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Modus:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbPdfPreviewMode" Width="180" SelectionChanged="CmbPdfPreviewMode_SelectionChanged" MaxDropDownHeight="180">
                <ComboBoxItem Content="Auto" IsSelected="True"/>
                <ComboBoxItem Content="WebView2"/>
                <ComboBoxItem Content="Text"/>
            </ComboBox>
            <TextBlock Text="Suchen:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <TextBox x:Name="TxtSearch" Width="160" VerticalContentAlignment="Center" KeyDown="TxtSearch_KeyDown" TextChanged="TxtSearch_TextChanged" ToolTip="Live-Suche nach kurzer Tipp-Pause. Enter = weiter, Umschalt+Enter = zurück. Treffer werden farbig markiert; die Suche schaltet bei Bedarf auf Text um."/>
            <Button Content="◀" Width="28" Margin="3,0,0,0" Click="BtnSearchPrev_Click"/>
            <Button Content="▶" Width="28" Margin="3,0,0,0" Click="BtnSearchNext_Click"/>
            <TextBlock x:Name="TxtSearchInfo" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
            <TextBox x:Name="TxtFileName" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold"
                     IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MaxWidth="420"
                     ToolTip="Dateiname markieren und mit Strg+C oder Rechtsklick → Kopieren kopieren. Strg+A markiert den gesamten Namen."/>
        </WrapPanel>
        
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="PdfWebView" Visibility="Collapsed"/>
            <Image x:Name="ImgPdfPreview" Stretch="Uniform" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PdfTextScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#F3F3F3" BorderBrush="#D8D8D8" BorderThickness="0,0,1,0" Margin="0,0,4,0">
                        <Canvas x:Name="LineGutter" Width="30" IsHitTestVisible="False" ClipToBounds="True"/>
                    </Border>
                    <Canvas x:Name="MarkLayer" Grid.Column="1" IsHitTestVisible="False"/>
                    <TextBox x:Name="TxtPdfFallback" Grid.Column="1"
                             SizeChanged="TxtPdfFallback_SizeChanged"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsInactiveSelectionHighlightEnabled="True"
                             SelectionBrush="Yellow"
                             SelectionOpacity="0.5"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

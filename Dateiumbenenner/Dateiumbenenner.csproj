<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>5.1.2623</Version>
    <Authors>everything-everything</Authors>
    <Product>Dateiumbenenner</Product>
    <Copyright>Copyright (c) 2026 everything-everything</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/everything-everything/Dateiumbenenner</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="SymSpell" Version="6.7.3" ExcludeAssets="contentFiles" />
  </ItemGroup>

  <ItemGroup>
    <!-- GeoNames postal codes DE (CC BY 4.0), embedded unchanged so it is covered by the code signature -->
    <EmbeddedResource Include="Data\GeoNames-DE.zip" LogicalName="Dateiumbenenner.Data.GeoNames-DE.zip" />
    <!-- Own word list for OCR word correction (MIT) -->
    <EmbeddedResource Include="Data\OcrFachwoerter.txt" LogicalName="Dateiumbenenner.Data.OcrFachwoerter.txt" />
  </ItemGroup>

</Project>

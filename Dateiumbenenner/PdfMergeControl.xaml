<UserControl x:Class="Dateiumbenenner.PdfMergeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header mit Buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button x:Name="BtnUseMainList" Content="Hauptliste Verwenden" Width="150" Margin="0,0,5,0" Click="BtnUseMainList_Click"/>
            <!-- NEU: Auswahl aus Hauptliste hinzufügen -->
            <Button x:Name="BtnLoadFromMain" Content="Auswahl aus Hauptliste" Width="160" Margin="5,0,5,0" Click="BtnLoadFromMain_Click"/>
            <Button x:Name="BtnAddFiles" Content="Dateien hinzufügen..." Width="150" Margin="5,0,5,0" Click="BtnAddFiles_Click"/>
            <Separator Width="20" Background="Transparent"/>
            <Button x:Name="BtnMoveUp" Content="↑ Nach oben" Width="100" Margin="5,0,5,0" Click="BtnMoveUp_Click"/>
            <Button x:Name="BtnMoveDown" Content="↓ Nach unten" Width="100" Margin="5,0,5,0" Click="BtnMoveDown_Click"/>
            <Separator Width="20" Background="Transparent"/>
            <Button x:Name="BtnRemoveSelected" Content="Auswahl entfernen" Width="120" Margin="5,0,5,0" Click="BtnRemoveSelected_Click"/>
            <Button x:Name="BtnDeleteSelected" Content="Dateien löschen" Width="120" Margin="5,0,5,0" Click="BtnDeleteSelected_Click" Background="#FFFFE0E0"/>
            <Button x:Name="BtnClearAll" Content="Alle entfernen" Width="100" Margin="5,0,5,0" Click="BtnClearAll_Click"/>
        </StackPanel>

        <!-- ListView mit PDF-Dateien -->
        <ListView x:Name="LvMergeItems" Grid.Row="1" Margin="10" SelectionMode="Extended" AllowDrop="True"
                  Drop="LvMergeItems_Drop" DragOver="LvMergeItems_DragOver" SelectionChanged="LvMergeItems_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="80">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Order" Content="Reihenfolge" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Order}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="400">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="FileName" Content="Dateiname" />
                        </GridViewColumn.Header>
                        <GridViewColumn.DisplayMemberBinding>
                            <Binding Path="FileName"/>
                        </GridViewColumn.DisplayMemberBinding>
                    </GridViewColumn>
                    <GridViewColumn Width="80">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="PageCount" Content="Seiten" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PageCount}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="90">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="FileSizeBytes" Content="Größe" />
                        </GridViewColumn.Header>
                        <GridViewColumn.DisplayMemberBinding>
                            <Binding Path="SizeDisplay"/>
                        </GridViewColumn.DisplayMemberBinding>
                    </GridViewColumn>
                    <GridViewColumn Width="60">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Dpi" Content="DPI" />
                        </GridViewColumn.Header>
                        <GridViewColumn.DisplayMemberBinding>
                            <Binding Path="DpiDisplay"/>
                        </GridViewColumn.DisplayMemberBinding>
                    </GridViewColumn>
                    <GridViewColumn Width="300">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="FilePath" Content="Pfad" />
                        </GridViewColumn.Header>
                        <GridViewColumn.DisplayMemberBinding>
                            <Binding Path="FilePath"/>
                        </GridViewColumn.DisplayMemberBinding>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Ausgabe-Optionen -->
        <GroupBox Grid.Row="2" Header="Ausgabe" Margin="10,0,10,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ausgabedatei:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtOutputPath" Grid.Row="0" Grid.Column="1" Margin="0,0,10,0"/>
                <Button x:Name="BtnBrowseOutput" Grid.Row="0" Grid.Column="2" Content="Durchsuchen..." Width="100" Click="BtnBrowseOutput_Click"/>

                <CheckBox x:Name="ChkOpenAfterMerge" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" 
                          Content="PDF nach dem Zusammenführen öffnen" Margin="0,10,0,0" IsChecked="True"/>
                
                <CheckBox x:Name="ChkDeleteAfterMerge" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" 
                          Content="Originaldateien nach dem Zusammenführen löschen" Margin="0,5,0,0" IsChecked="False"/>

                <!-- NEU: Kompressionseinstellungen -->
                <Expander Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" 
                          Header="📦 Kompressionseinstellungen" Margin="0,10,0,0" IsExpanded="False">
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,5,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Kompression aktivieren - GANZ OBEN -->
                            <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" 
                                      x:Name="ChkEnableCompression" Content="✅ Kompression aktivieren" 
                                      IsChecked="False" FontWeight="Bold" Foreground="Green"
                                      Margin="0,0,0,10" Checked="ChkEnableCompression_Changed" Unchecked="ChkEnableCompression_Changed"/>

                            <!-- DPI-Einstellung -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Bild-DPI:" VerticalAlignment="Top" Margin="0,0,10,0"
                                       IsEnabled="{Binding ElementName=ChkEnableCompression, Path=IsChecked}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5,0,0"
                                        IsEnabled="{Binding ElementName=ChkEnableCompression, Path=IsChecked}">
                                <Slider x:Name="SliderImageDpi" Minimum="72" Maximum="600" Value="150" Width="160"
                                        TickFrequency="1" IsSnapToTickEnabled="False" AutoToolTipPlacement="TopLeft"
                                        AutoToolTipPrecision="0" ValueChanged="SliderImageDpi_ValueChanged"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Aktuell:" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtImageDpiDisplay" Text="150 dpi" Margin="4,0,10,0" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtImageDpiValue" Width="60" Text="150" VerticalAlignment="Center"
                                             ToolTip="DPI direkt eingeben (72-600)" LostFocus="TxtImageDpiValue_LostFocus"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkImageDpiOriginal" Content="Original-DPI beibehalten" Margin="0,4,0,0"
                                          IsChecked="False" Checked="ChkImageDpiOriginal_Changed" Unchecked="ChkImageDpiOriginal_Changed"/>
                            </StackPanel>

                            <!-- JPEG-Qualität + Modus rechts -->
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="JPEG-Qualität:" VerticalAlignment="Top" Margin="15,0,10,0"
                                       IsEnabled="{Binding ElementName=ChkEnableCompression, Path=IsChecked}"/>
                            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Vertical" Margin="0,5" IsEnabled="{Binding ElementName=ChkEnableCompression, Path=IsChecked}">
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="SliderJpegQuality" Minimum="10" Maximum="100" Value="75" Width="120" 
                                            VerticalAlignment="Center" TickFrequency="5" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderJpegQuality_ValueChanged"/>
                                    <TextBlock x:Name="TxtJpegQualityValue" Text="75%" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Modus:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbCompressionMode" Width="200" SelectedIndex="0">
                                        <ComboBoxItem Content="Ghostscript (extern)" Tag="Ghostscript"/>
                                        <ComboBoxItem Content="Nur neu schreiben (verlustfrei)" Tag="Rewrite"/>
                                                                            <ComboBoxItem Content="Rasterisieren (Seiten als JPEG, Text nicht mehr markierbar)" Tag="Rasterize"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- Zusätzliche Optionen -->
                            <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                      x:Name="ChkRemoveMetadata" Content="Metadaten entfernen (kleinere Datei)" 
                                      IsChecked="False" Margin="0,5"
                                      IsEnabled="{Binding ElementName=ChkEnableCompression, Path=IsChecked}"/>
                            
                            <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" 
                                      x:Name="ChkOptimizeFonts" Content="Schriften optimieren" 
                                      IsChecked="True" Margin="15,5,0,5"
                                      IsEnabled="{Binding ElementName=ChkEnableCompression, Path=IsChecked}"/>

                            <!-- Info-Text -->
                            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" 
                                    Background="LightYellow" BorderBrush="Orange" BorderThickness="1" 
                                    Padding="8" Margin="0,10,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="11">
                                    <Run Text="💡 Empfehlungen:" FontWeight="Bold"/>
                                    <LineBreak/>
                                    <Run Text="• Text-PDFs: 150 dpi, 75% Qualität (ca. 60-80% Größenreduktion)"/>
                                    <LineBreak/>
                                    <Run Text="• Bild-/Scan-PDFs: 200 dpi, 80% Qualität (ca. 40-60% Größenreduktion)"/>
                                    <LineBreak/>
                                    <Run Text="• Druck-Qualität: 300 dpi, 85% Qualität (ca. 20-30% Größenreduktion)"/>
                                    <LineBreak/>
                                    <Run Text="• Hochauflösend: 450-600 dpi, 90% Qualität (minimale Reduktion)"/>
                                    <LineBreak/>
                                    <Run Text="⚠️ Hinweis: Modus 'Ghostscript' benötigt eine lokale Installation. 'Nur neu schreiben' bewirkt meist geringe Reduktion." FontStyle="Italic" Foreground="DarkRed"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                </Expander>
            </Grid>
        </GroupBox>

        <!-- Aktions-Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="DarkBlue"/>
            <Button x:Name="BtnMergeSelected" Content="Ausgewählte zusammenführen/komprimieren" Width="280" Margin="0,0,5,0" 
                    Height="30" Click="BtnMergeSelected_Click" FontWeight="Bold"/>
            <Button x:Name="BtnMergeAll" Content="Alle zusammenführen/komprimieren" Width="250" Margin="5,0,0,0" 
                    Height="30" Click="BtnMergeAll_Click" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</UserControl>
